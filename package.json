{
  "name": "localshare",
  "version": "1.0.0",
  "description": "Cross-Platform Local Wi-Fi File Sharing Desktop Application",
  "author": "LocalShare Team <contact@localshare.app>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rahul0070050/localshare.git"
  },
  "main": "dist-electron/server/electron/main.js",
  "scripts": {
    "clean:processes": "node scripts/clean-processes.js",
    "prebuild": "node scripts/clean-processes.js",
    "predist": "node scripts/clean-processes.js",
    "dev:renderer": "next dev -p 3456",
    "dev:electron": "tsc -p tsconfig.electron.json --watch",
    "build:client": "esbuild client/src/index.tsx --bundle --minify --format=iife --jsx-factory=h --jsx-fragment=Fragment --outfile=client/bundle.js && node -e \"const fs=require('fs'); fs.mkdirSync('dist-electron/client', {recursive:true}); fs.copyFileSync('client/bundle.js', 'dist-electron/client/bundle.js');\"",
    "build:renderer": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:client && npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win dir",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:tar": "npm run build && electron-builder --linux tar.gz",
    "test": "node dist-electron/test/test-server.js",
    "test:integration": "node dist-electron/test/test-integration.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "mime-types": "^2.1.35",
    "next": "^14.2.15",
    "preact": "^11.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}