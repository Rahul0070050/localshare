{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "server/core/**/*",
    "server/electron/**/*",
    "client/**/*",
    "shared/**/*",
    "test/**/*"
  ],
  "exclude": [
    "server/desktop/**/*",
    "src/**/*",
    "node_modules",
    "dist",
    "dist-electron"
  ]
}
