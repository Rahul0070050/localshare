{
  "appId": "com.localshare.desktop",
  "productName": "LocalShare",
  "copyright": "Copyright © 2026 LocalShare Team",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**/*",
    "out/**/*",
    "package.json",
    "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
    "!**/node_modules/*/{test,__tests__,tests,powertags,example,examples}",
    "!**/node_modules/*.d.ts",
    "!**/node_modules/.bin"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "LocalShare"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Network;FileTransfer;",
    "icon": "build/icon.png",
    "desktop": {
      "StartupWMClass": "LocalShare",
      "MimeType": "x-scheme-handler/localshare"
    }
  },
  "deb": {
    "depends": [
      "libnotify4",
      "libxtst6",
      "libnss3",
      "xdg-utils"
    ]
  }
}
